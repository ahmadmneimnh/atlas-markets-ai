# ─── Atlas Markets AI ─────────────────────────────────────────────────────────
# Copy to .env and fill in what you have. The app runs with NONE of these set:
# crypto is served by CoinGecko + Binance public endpoints, which need no key.
# Any capability without a configured provider reports as unavailable rather than
# falling back to estimated data.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Database (required for watchlists, portfolios, alerts, score history) ────
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas

# ─── Cache (optional — an in-process LRU is used when unset) ──────────────────
REDIS_URL=redis://localhost:6379

# ─── Equity data ──────────────────────────────────────────────────────────────
# Finnhub is the recommended first key: free tier covers quotes, profiles,
# fundamentals, company news and search at 60 req/min. https://finnhub.io/register
FINNHUB_API_KEY=

# Alpha Vantage free tier is 25 requests/DAY — configured as an OHLCV fallback
# only. https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Not yet implemented as adapters; reserved for the next providers added.
TWELVE_DATA_API_KEY=
FMP_API_KEY=
POLYGON_API_KEY=

# ─── Crypto data ──────────────────────────────────────────────────────────────
# Optional. Without it CoinGecko's public tier is used (lower rate limit).
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=

# ─── News ─────────────────────────────────────────────────────────────────────
NEWSAPI_KEY=

# ─── Provider routing (the swap seam) ─────────────────────────────────────────
# Comma-separated provider ids, highest priority first. Overrides the built-in
# defaults, so swapping a vendor is a config change rather than a code change.
# ATLAS_PRIORITY_QUOTE=finnhub
# ATLAS_PRIORITY_OHLCV=binance,alphavantage,coingecko
# ATLAS_PRIORITY_FUNDAMENTALS=finnhub,alphavantage
# ATLAS_PRIORITY_NEWS=finnhub

LOG_LEVEL=info
