# ─── Batal's Brain — API keys ────────────────────────────────────────────────
#
# HOW TO USE THIS FILE
# 1. Make a copy of it in this same folder and name the copy:  .env.local
# 2. Paste your keys after the "=" signs below. No quotes, no spaces.
# 3. Save the file and restart the app (stop it with Ctrl+C, then `npm run dev`).
#
# The app runs with NONE of these filled in — cryptocurrency works with no key at
# all. Anything that has no key configured shows "Insufficient Data" instead of a
# made-up number.
#
# Never share this file or commit it to GitHub. `.env.local` is ignored by git.


# ─── Stocks (recommended) ────────────────────────────────────────────────────
# Free key, no card required, takes about a minute: https://finnhub.io/register
# Enables: stock prices on the dashboard, stock search, company statistics.
FINNHUB_API_KEY=

# ─── Stock price charts (optional) ───────────────────────────────────────────
# Free key: https://www.alphavantage.co/support/#api-key
# Enables: the price history chart on a stock's page.
# Note: the free plan allows only 25 requests per day, so charts will stop
# loading after 25 different stock charts in a day. Crypto charts are unlimited.
ALPHA_VANTAGE_API_KEY=

# ─── Cryptocurrency (optional) ───────────────────────────────────────────────
# Crypto already works without a key, using CoinGecko's and Binance's free public
# data. Add a CoinGecko key only if you hit their rate limit and want a higher
# one: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=


# ─── Analysis engine (optional) ──────────────────────────────────────────────
# Which symbol stands in for "the stock market" when judging market conditions.
# Read once every 30 minutes, and only when ALPHA_VANTAGE_API_KEY is set — it
# costs one of that plan's 25 daily requests. Set it to empty to switch the
# benchmark read off entirely; market conditions then fall back to the breadth of
# the tracked stock list, which costs nothing extra.
BB_MARKET_BENCHMARK=SPY


# ─── Advanced (leave these alone unless you know why) ────────────────────────
# Which data source to prefer for each kind of data, best first. Overrides the
# built-in defaults, so switching providers is a settings change, not a code one.
# BB_PRIORITY_QUOTE=finnhub
# BB_PRIORITY_CRYPTO_QUOTE=coingecko,binance
# BB_PRIORITY_OHLCV=alphavantage
# BB_PRIORITY_CRYPTO_OHLCV=binance,coingecko

# How much detail to print in the terminal: debug, info, warn or error.
LOG_LEVEL=info
