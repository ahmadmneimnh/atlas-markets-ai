# ══════════════════════════════════════════════════════════════════════════════
#  Atlas Markets AI — environment template
# ══════════════════════════════════════════════════════════════════════════════
#
#   cp .env.example .env
#
# One file at the repository root configures every service. Each service
# validates the subset it needs at startup and exits if that subset is wrong
# (apps/web/src/lib/env.ts, services/worker/src/lib/env.ts,
# services/ai-engine/app/core/config.py).
#
# THE APP RUNS WITH NONE OF THESE SET. Crypto is served by CoinGecko's public
# tier and Binance's public market-data endpoints, neither of which needs a
# credential. Any capability without a configured provider reports as
# unavailable — it never falls back to estimated data.
#
# Every value below is a placeholder. Never commit a filled-in .env; it is
# gitignored for a reason.

NODE_ENV=development
LOG_LEVEL=info

# ─── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WEB_PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Required for watchlists, portfolios, alerts and score history. `npm run
# infra:up` starts a Postgres matching these defaults.
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas
POSTGRES_PORT=5432

# ─── Cache and queues ─────────────────────────────────────────────────────────
# Optional for the web app (an in-process LRU is used when unset).
# Required for the worker: BullMQ is Redis, with no in-memory fallback.
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ─── Worker ───────────────────────────────────────────────────────────────────
# Concurrency is bounded by provider rate limits, not by CPU. Raising this
# without raising the provider tier just moves the failure from "slow" to "429".
WORKER_CONCURRENCY=4
WORKER_SCHEDULES_ENABLED=true

# ─── AI engine ────────────────────────────────────────────────────────────────
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8000
# Shared secret presented by the BFF and worker. Optional locally; required when
# NODE_ENV=production, where the service refuses to start without it.
AI_ENGINE_API_KEY=
# Fraction of nominal factor weight that must be scoreable before the engine will
# return a number at all. Below it, /v1/score answers 422 with the reason each
# factor was omitted.
AI_ENGINE_MIN_COVERAGE=0.25

# ─── Equity data ──────────────────────────────────────────────────────────────
# Finnhub is the recommended first key: the free tier covers quotes, profiles,
# fundamentals, company news and search at 60 req/min. https://finnhub.io/register
FINNHUB_API_KEY=

# Alpha Vantage's free tier is 25 requests per DAY — wired as an OHLCV fallback
# only. https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Env slots exist; adapters do not yet. Each is one file against the existing
# provider interface.
TWELVE_DATA_API_KEY=
FMP_API_KEY=
POLYGON_API_KEY=

# ─── Crypto data ──────────────────────────────────────────────────────────────
# Optional. Without it, CoinGecko's public tier is used at a lower rate limit.
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=

# ─── News ─────────────────────────────────────────────────────────────────────
NEWSAPI_KEY=

# ─── Provider routing (the vendor-swap seam) ──────────────────────────────────
# Comma-separated provider ids, highest priority first. Overrides the built-in
# defaults, so replacing a vendor is a config change rather than a code change.
# ATLAS_PRIORITY_QUOTE=finnhub
# ATLAS_PRIORITY_OHLCV=binance,alphavantage,coingecko
# ATLAS_PRIORITY_FUNDAMENTALS=finnhub,alphavantage
# ATLAS_PRIORITY_NEWS=finnhub

# ─── Authentication ───────────────────────────────────────────────────────────
# Sign-in is optional: market data and AI scores work signed out. It switches on
# when AUTH_SECRET, a database, and at least one provider below are all present.
# A provider missing its credentials is omitted entirely rather than rendered as
# a button that fails on click.
#
# REQUIRED for auth. Generate with:  openssl rand -base64 32
AUTH_SECRET=
# Only needed behind a proxy or on a non-localhost origin.
# AUTH_URL=http://localhost:3000

# Google — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub — https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Apple — https://developer.apple.com/account/resources/identifiers
# APPLE_CLIENT_SECRET is NOT a static string: Apple requires a short-lived ES256
# JWT signed with your .p8 key, valid at most six months. Mint one with:
#   npm run auth:apple-secret
# and set the four APPLE_* inputs below first. Re-mint before it expires or
# Apple sign-in stops working with no other warning.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=./AuthKey_XXXXXXXXXX.p8

# Email magic links. Any SMTP server; the link expires in 15 minutes.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Atlas Markets AI <no-reply@example.com>"

# ─── Notification channels ────────────────────────────────────────────────────
# Alert delivery. Each channel is independent: an unconfigured one reports
# "not_configured" on its own delivery row rather than failing the whole alert,
# and never reports success for a message it did not send.
#
# EMAIL reuses the EMAIL_SERVER_* settings above.
#
# Telegram: create a bot with @BotFather, then have each user start a chat with
# it — the chat id is stored per user, not here.
TELEGRAM_BOT_TOKEN=

# Discord: a server webhook URL. Users may also supply their own per alert.
DISCORD_WEBHOOK_URL=

# Web push (VAPID). Generate with: npx web-push generate-vapid-keys
# Not yet wired — the channel reports not_configured rather than pretending.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com

# Where the worker reads market data from. It goes through the BFF rather than
# calling providers directly, so rate limits stay in one process.
ATLAS_API_URL=http://localhost:3000

# ─── Observability (Phase 10) ─────────────────────────────────────────────────
GRAFANA_PASSWORD=atlas
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
