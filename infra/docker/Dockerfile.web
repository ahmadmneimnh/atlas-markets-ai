# Atlas Markets AI — Next.js app.
#
# Build context is the repository root: apps/web depends on workspace packages
# that live outside its directory.
#
# The runner stage carries only Next's standalone output, so provider adapters
# and the credentials they read are never present in a client-servable layer.

FROM node:22-alpine AS deps
WORKDIR /repo

# Manifests first, source second. Dependencies change far less often than code,
# so this layer survives most rebuilds — the difference between a 5-second and a
# 90-second iteration.
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/config/package.json ./packages/config/
COPY packages/core/package.json ./packages/core/
COPY packages/db/package.json ./packages/db/
COPY services/worker/package.json ./services/worker/
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /repo
COPY --from=deps /repo/node_modules ./node_modules
COPY . .

# Generated before the build: the Prisma client is imported at build time by any
# route that touches the database. Generation is offline — no DATABASE_URL
# required, which keeps the connection string out of the image.
RUN npm run db:generate
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001

# The standalone bundle mirrors the workspace layout, so server.js sits under
# apps/web and the hoisted node_modules sits at the root of the copied tree.
COPY --from=builder --chown=nextjs:nodejs /repo/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /repo/apps/web/.next/static ./apps/web/.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
