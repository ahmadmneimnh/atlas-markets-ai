{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Atlas base",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,

    /* Strictness. `noUncheckedIndexedAccess` is the one that matters most here:
       every OHLCV series is an array indexed by offset, and an off-by-one at the
       end of a series is otherwise typed as a definite number. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["node_modules", "dist", ".next"]
}
